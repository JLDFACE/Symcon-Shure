{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "MXA920 IP-Adresse"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "TCP Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "MeterRate",
      "caption": "Pegel-Metering (ms, 0 = aus)",
      "minimum": 0,
      "maximum": 99999
    },
    {
      "type": "NumberSpinner",
      "name": "TalkerPositionRate",
      "caption": "Sprecher-Positionen (ms, 0 = aus, für Speaker Tracking z. B. 300)",
      "minimum": 0,
      "maximum": 99999
    },
    {
      "type": "NumberSpinner",
      "name": "PollSlow",
      "caption": "Poll Slow (s)",
      "minimum": 5,
      "maximum": 300
    },
    {
      "type": "NumberSpinner",
      "name": "PollFast",
      "caption": "Poll Fast (s)",
      "minimum": 1,
      "maximum": 60
    },
    {
      "type": "NumberSpinner",
      "name": "FastAfterChangeSeconds",
      "caption": "Fast Polling Duration (s)",
      "minimum": 10,
      "maximum": 300
    },
    {
      "type": "NumberSpinner",
      "name": "TimeoutMs",
      "caption": "Command Timeout (ms)",
      "minimum": 500,
      "maximum": 5000
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Device ID lesen",
      "onClick": "MXA920_ReadDeviceID($id);"
    },
    {
      "type": "Button",
      "caption": "Status aktualisieren",
      "onClick": "MXA920_PollNow($id);"
    },
    {
      "type": "Button",
      "caption": "Identify (LED blinken)",
      "onClick": "MXA920_Identify($id, true);"
    },
    {
      "type": "Button",
      "caption": "Identify aus",
      "onClick": "MXA920_Identify($id, false);"
    }
  ]
}
